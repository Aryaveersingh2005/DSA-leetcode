class Solution {
    public int totalNQueens(int n) {
        List<List<String>> list = nqueens(new boolean[n][n], 0, new ArrayList<>());
        return list.size();
    }

    List<List<String>> nqueens(boolean[][] board, int row, List<List<String>> list){
        if(row == board.length){
            list.add(getList(board));
        }

        for(int col = 0 ; col < board.length ; col++){
            if(isSafe(board, row, col)){
                board[row][col] = true;
                nqueens(board, row + 1, list);
                board[row][col] = false;
            }
        }

        return list;
    }

    boolean isSafe(boolean[][] board, int row, int col){

        //check vertical
        for(int i = 0; i < row ; i++){
            if(board[i][col]){
                return false;
            }
        }

        //check left
        int minLeft = row > col ? col : row;

        for(int i = 1 ; i <= minLeft ; i++){
            if(board[row - i][col - i]){
                return false;
            }
        }

        //check right
        int minRight = Math.min(row, board.length - col - 1);

        for(int i = 1; i <= minRight ; i++){
            if(board[row - i][col + i]){
                return false;
            }
        }


        return true;
    }

    List<String> getList(boolean[][] board){
        List<String> result = new ArrayList<>();

        for(boolean[] lis : board){
            StringBuilder str = new StringBuilder();
            for(int i  = 0; i < lis.length ; i++){
                if(lis[i]){
                    str.append("Q");
                } else {
                    str.append(".");
                }
            }
            result.add(str.toString());
        }

        return result;
    }
}
